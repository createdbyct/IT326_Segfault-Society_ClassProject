# Postgres (Neon) — your database connection
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL_POOLED=postgresql://USER:PASSWORD@HOST-pooler/DBNAME?sslmode=require
